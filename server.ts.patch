+
+  const wss = new WebSocketServer({ server, path: '/api/live' });
+  wss.on('connection', (ws) => {
+    const ai = getGeminiClient();
+    if (!ai) {
+      ws.close(1011, 'Gemini API not configured');
+      return;
+    }
+    
+    let geminiWs: any = null;
+    
+    ws.on('message', async (message) => {
+      try {
+        const data = JSON.parse(message.toString());
+        
+        if (data.type === 'start') {
+          const session = await ai.clients.createWebSocketClient({
+            url: `wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent?key=${process.env.GEMINI_API_KEY}`
+          });
+          geminiWs = session;
+        }
+      } catch(err) {
+        console.error("Live API Error", err);
+      }
+    });
+  });
 }
 
